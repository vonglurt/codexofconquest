# MIT License — Copyright (c) 2026 Paul Richeson
# .githooks/pre-commit — auto-purge transient artifacts before each commit.
#
# Calls scripts/cleanup-cruft.sh, then re-stages any deletions or
# truncations so the cleanup lands in this commit.  Quiet by default so
# it doesn't drown out commit output; pass CLEANUP_VERBOSE=1 to see
# per-file activity.
#
# Activated by running once:
#   git config core.hooksPath .githooks
#
# Skip on demand with:
#   SKIP_CLEANUP=1 git commit ...

set -euo pipefail

if [ "${SKIP_CLEANUP:-}" = "1" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT="$REPO_ROOT/src/scripts/cleanup-cruft.sh"

if [ ! -x "$SCRIPT" ]; then
  echo "[pre-commit] cleanup-cruft.sh not found or not executable — skipping" >&2
  exit 0
fi

if [ "${CLEANUP_VERBOSE:-}" = "1" ]; then
  "$SCRIPT"
else
  "$SCRIPT" --quiet
fi

# Re-stage transient deletions/truncations into this commit.
# `git add -A -- build/milepoints/` follows .gitignore, so the ignored patches/
# directory is skipped automatically — only tracked files (heatmaps,
# reweave-maps, api-cli.log, say.log) get their deletions/edits staged.
# Errors are tolerated: a fresh clone may not have milepoints/ yet.
git -C "$REPO_ROOT" add -A -- build/milepoints/ 2>/dev/null || true

# Stamped HTML snapshots at repo root (roll2hit-v3-YYYYMMDD-HHMMSS.html)
shopt -s nullglob
for f in "$REPO_ROOT"/play-[0-9]*.html; do
  git -C "$REPO_ROOT" add -A -- "$(basename "$f")" 2>/dev/null || true
done
shopt -u nullglob

exit 0
