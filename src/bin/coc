#!/usr/bin/env bash
# coc — one launcher for CodexOfConquest. Run `./coc help` for the menu.
# Everything the project needs, behind short verbs. Keep it obvious.
set -euo pipefail
DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$DIR"

PORT="${PORT:-1367}"
open_url() { command -v open >/dev/null 2>&1 && open "$1" || xdg-open "$1"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  serve)    echo "▶ WBAPI + game server on http://localhost:$PORT/  (Ctrl-C to stop)"
            exec node src/js/wbapi-server.js "$@" ;;
  game)     open_url "$DIR/play.html" ;;            # single-file game (standalone)
  world)    open_url "$DIR/edit.html" ;;           # world builder (needs `serve` for the API)
  test)     exec npx playwright test "$@" ;;
  checks)   exec npm run check:walk ;;
  mud)      exec npm run test:mud ;;
  api)      exec ./bin/api "$@" ;;                          # passthrough to the WBAPI CLI
  tracker)  exec ./wbapi-toggle.sh tracker "$@" ;;
  toggle)   exec ./wbapi-toggle.sh "$@" ;;                 # start|stop|restart|status
  help|-h|--help|*)
    cat <<EOF
coc — CodexOfConquest launcher

  ./coc serve      start the WBAPI + game server (http://localhost:$PORT/)
  ./coc game       open the standalone game (play.html) in a browser
  ./coc world      open the world builder (run 'serve' first for live API)
  ./coc test       run the Playwright suite
  ./coc checks     run the walk/parity invariants (npm run check:walk)
  ./coc mud        run the MUD harness (npm run test:mud)
  ./coc api ...    WBAPI CLI passthrough (./bin/api)
  ./coc tracker    start the mesh tracker
  ./coc toggle ... server daemon control (start|stop|restart|status)

Layout: runtime JS → js/ · data + config → config/ · docs at root.
EOF
    ;;
esac
