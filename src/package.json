{
  "name": "codexofconquest",
  "version": "1.0.0",
  "description": "Codex of Conquest — a single-file, quest-driven MUD-style fighter RPG with D&D 5e mechanics. This package holds the world-builder API server, CLI and test suite.",
  "keywords": [
    "rpg",
    "mud",
    "dnd",
    "d20",
    "roguelike",
    "interactive-fiction",
    "game",
    "single-file",
    "html5",
    "worldbuilder"
  ],
  "homepage": "https://codexofconquest.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vonglurt/codexofconquest.git"
  },
  "bugs": {
    "url": "https://github.com/vonglurt/codexofconquest/issues"
  },
  "author": "Paul Richeson <paulr@sdf.org>",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node js/wbapi-server.js",
    "stats": "node scripts/stats.js",
    "nodes": "node scripts/node-index.js",
    "anchors": "node scripts/resolve-anchors.js",
    "anchors:fix": "node scripts/resolve-anchors.js --fix",
    "pretest": "node scripts/cleantree.js --snapshot",
    "test": "playwright test -c playwright.config.js",
    "posttest": "node scripts/cleantree.js",
    "test:headed": "playwright test -c playwright.config.js --headed",
    "test:install": "playwright install chromium",
    "check:invariants": "node scripts/check-invariants.js",
    "check:dupkeys": "node scripts/check-dupkeys.js --selftest && node scripts/check-dupkeys.js",
    "check:parity": "node scripts/check-mover-parity.js",
    "check:behaviour": "node scripts/check-mover-behaviour.js",
    "check:terrain": "node scripts/check-terrain-parity.js",
    "check:roads": "node scripts/check-roads.js",
    "check:roomsparity": "node scripts/check-rooms-parity.js",
    "check:duelparity": "node scripts/check-duel-parity.js",
    "check:questparity": "node scripts/check-quest-parity.js",
    "check:gateast": "node scripts/check-gate-parity.js",
    "check:rng": "node scripts/check-rng-parity.js",
    "check:questgraph": "node scripts/check-questgraph.js --selftest && node scripts/check-questgraph.js",
    "check:nodeindex": "node scripts/node-index.js --check",
    "check:noderegs": "node scripts/check-noderegs.js --selftest && node scripts/check-noderegs.js",
    "check:npcregs": "node scripts/check-npcregs.js --selftest && node scripts/check-npcregs.js",
    "check:anchors": "node scripts/resolve-anchors.js --selftest && node scripts/resolve-anchors.js",
    "check:legacycodes": "node scripts/legacy-codes.js --check",
    "check:spdx": "node scripts/check-spdx.js --selftest && node scripts/check-spdx.js",
    "check:backlogcounts": "node scripts/check-backlogcounts.js --selftest && node scripts/check-backlogcounts.js",
    "check:docpointers": "node scripts/check-docpointers.js --selftest && node scripts/check-docpointers.js",
    "legacy": "node scripts/legacy-codes.js",
    "check:arraypatch": "node scripts/check-array-patch.js",
    "check:itemchain": "node scripts/check-itemchain.js",
    "check:battlepools": "node scripts/check-battlepools.js --selftest && node scripts/check-battlepools.js",
    "check:condprices": "node scripts/check-condition-prices.js --selftest && node scripts/check-condition-prices.js",
    "check:laddermigration": "node scripts/check-ladder-migration.js",
    "check:worlddiff": "node scripts/world-diff.js --selftest",
    "test:mud": "node tests/mud-harness.mjs",
    "check:walk": "node scripts/run-gates.js --selftest",
    "check:walk:serial": "npm run check:invariants && npm run check:dupkeys && npm run check:parity && npm run check:behaviour && npm run check:terrain && npm run check:roads && npm run check:roomsparity && npm run check:questparity && npm run check:gateast && npm run check:rng && npm run check:questgraph && npm run check:nodeindex && npm run check:noderegs && npm run check:npcregs && npm run check:anchors && npm run check:legacycodes && npm run check:battlepools && npm run check:spdx && npm run check:backlogcounts && npm run check:condprices && npm run check:docpointers",
    "cleantree:selftest": "node scripts/cleantree.js --selftest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
