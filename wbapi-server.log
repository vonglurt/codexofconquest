2026-05-30 01:50:12.455  POST    quest
  │  → body
  │  {
  │    "id": "quest_1367_c_ottoman",
  │    "type": "skill_check",
  │    "title": "The Patchwork of Adrianople",
  │    "desc": "Bogdan must pass an Ottoman checkpoint in the contested Balkans. DC 14 Deception or talk your way through.",
  │    "hint": "The soldiers are bored and cold. Give them a reason to wave you through that costs them nothing.",
  │    "activateNode": "CY",
  │    "activateCond": "() => true",
  │    "checkAbility": "cha",
  │    "checkLabel": "Deception",
  │    "checkDC": 14,
  │    "xpAward": 130,
  │    "retryable": true,
  │    "retryGateDays": 0,
  │    "vignetteText": "The checkpoint is a rope across the road and two Ottoman soldiers with spears and the particular expression of men who have been standing in the same place since before dawn. They are not hostile. They are thorough. Bogdan’s family served the Bulgarian lord whose land is now technically Ottoman-administered territory, which makes Bogdan’s status something no one has bothered to formally clarify. That ambiguity is either a problem or a tool.",
  │    "passText": "You tell them you are delivering a message to the garrison at Adrianople, from the lord’s steward, whose name you provide with confidence. The name is real. The message is not. They wave you through. The city’s walls are visible by midmorning. Adrianople is Ottoman now. You walk into it anyway, because the road goes through it and you have no other road.",
  │    "failText": "They ask for the letter. You do not have a letter. They are not unkind but they are immovable. You turn back and find the longer road around, which costs you a day and takes you through a village that is not on any map you have seen, where the people speak a language that is neither Bulgarian nor Turkish but something older than both.",
  │    "onPass": "() => { S_story.faith_orthodox = Math.min(5, (S_story.faith_orthodox || 0) + 1); }",
  │    "onFail": "() => {}",
  │    "disposition": "The Balkans in 1367 are a place where every road goes through someone else’s recent decision. You learn to carry ambiguity like a document."
  │  }
