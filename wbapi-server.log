2026-05-30 01:55:49.984  POST    quest
  │  → body
  │  {
  │    "id": "quest_1367_f_plague",
  │    "type": "combat",
  │    "title": "The Empty Village",
  │    "desc": "Clear Sainte-Marthe-des-Pres of 4 Plague Walkers and 1 Hollow Reeve. plague_exposed risk on fail. faith_folk track.",
  │    "hint": "The Hollow Reeve does not want to fight. It wants to be acknowledged. That is different.",
  │    "activateNode": "CY",
  │    "activateCond": "() => true",
  │    "xpAward": 160,
  │    "retryable": true,
  │    "retryGateDays": 0,
  │    "vignetteText": "The village has been empty for nineteen years. The plague took it in three weeks in 1348. The property belongs now to a distant cousin whose claim Cecile is here to certify, if the village is inhabitable, which requires the village to be cleared, which is why there is a notary's commission in her satchel and a sword at her belt that she did not have before she took this work.",
  │    "passText": "The Plague Walkers dissolve when the Hollow Reeve sits down on the stone at the edge of the pit and then is not there. Cecile seals the pit, writes her report, recommends the cousin's claim. She adds the village to a list she keeps of places visited. She does not know why she keeps the list. She thinks it is for the same reason the carver carved the names: so something remembers where the empty places are.",
  │    "failText": "The Hollow Reeve does not dissolve. You retreat with a wound that smells wrong. Roll CON DC 13 or gain plague_exposed. The village is still empty. The cousin waits.",
  │    "onPass": "() => { S_story.faith_folk = Math.min(5, (S_story.faith_folk || 0) + 1); }",
  │    "onFail": "() => { if (Math.random() > 0.5) S_story.plague_exposed = true; }",
  │    "disposition": "The sky counts them. But someone has to give them to the sky."
  │  }
