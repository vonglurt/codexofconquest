  │  {
  │    "id": "quest_1367_d_hansa",
  │    "type": "skill_check",
  │    "title": "The Amber Embargo",
  │    "desc": "Hilde Magnusdottir must negotiate with a Hanseatic factor to lift an embargo strangling Birka. DC 15 Persuasion. faction_hansa affected.",
  │    "hint": "The League wants profit, not punishment. Show him a number that makes lifting the embargo worth more than keeping it.",
  │    "activateNode": "BK",
  │    "activateCond": "() => true",
  │    "checkAbility": "cha",
  │    "checkLabel": "Persuasion",
  │    "checkDC": 15,
  │    "xpAward": 140,
  │    "retryable": true,
  │    "retryGateDays": 0,
  │    "vignetteText": "The Hanseatic factor has a face like a ledger page. The embargo is two months old. Birka's amber market is half its normal size. Three warehouses have closed. The factor sits across the table with his hands folded and his account books closed because he already knows what is in them.",
  │    "passText": "You lay out the numbers he has not added yet — what the embargo costs the League in lost future trade if Birka's amber network collapses entirely. He listens. He re-adds. He opens the book. The embargo lifts in the morning.",
  │    "failText": "He listens. He does not re-add anything. The embargo stands. He says it will be reviewed in thirty days. The thirty days will be long for everyone except the factor, who has other ports.",
  │    "onPass": "() => { S_story.faction_hansa = Math.min(5, (S_story.faction_hansa || 0) + 2); }",
  │    "onFail": "() => { S_story.faction_hansa = Math.max(-5, (S_story.faction_hansa || 0) - 1); }",
  │    "disposition": "The Hanseatic League does not embargo out of malice. It embargoes out of arithmetic. You have to speak arithmetic back at it."
  │  }
