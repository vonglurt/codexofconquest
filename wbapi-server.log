2026-05-30 01:56:30.875  POST    quest
  │  → body
  │  {
  │    "id": "quest_lxvii67",
  │    "type": "skill_check",
  │    "title": "The Jester's Crossroads",
  │    "desc": "The jester does not ask a question. Two must arrive alone and answer it anyway. DC 10 Insight. Self-serve. No Help action.",
  │    "hint": "The answer is not written anywhere. You already know it.",
  │    "activateNode": "CY",
  │    "activateCond": "() => (S_story.faith_folk || 0) >= 1",
  │    "checkAbility": "wis",
  │    "checkLabel": "Insight",
  │    "checkDC": 10,
  │    "xpAward": 67,
  │    "retryable": true,
  │    "retryGateDays": 0,
  │    "vignetteText": "A painted post at a fork in the road. No sign. A jester on a stone, tossing a coin. He does not speak. He holds up two fingers. The coin goes up and up. The question he is not asking is: do you know the answer to the question I am not asking? The answer is 67. You have to arrive at it yourself.",
  │    "passText": "You write the number on a scrap of paper and set it on the stone. He catches the coin, does not look at it, nods once. One. Someone else will be the second. When the second arrives and writes the same number, he stands up and dabs. Completely sincere. The post opens. There is a carved coin inside: LXVII on one face, 67 on the other.",
  │    "failText": "You write a different number. He takes the paper, folds it carefully, puts it in his coat. He collects wrong answers. Not to shame them. Wrong answers need somewhere to go too. Come back when you know.",
  │    "onPass": "() => { S_story.faith_folk = Math.min(5, (S_story.faith_folk || 0) + 1); }",
  │    "onFail": "() => {}",
  │    "disposition": "67 > 69. taps chest. self-serve. double dab. ⁶⁷"
  │  }
