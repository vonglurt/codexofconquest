{
  "name": "roll2hit-wbapi",
  "version": "1.0.0",
  "description": "Roll2Hit World Builder API server and CLI tools",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node src/js/wbapi-server.js",
    "stats": "node src/scripts/stats.js",
    "nodes": "node src/scripts/node-index.js",
    "anchors": "node src/scripts/resolve-anchors.js",
    "anchors:fix": "node src/scripts/resolve-anchors.js --fix",
    "test": "playwright test -c src/playwright.config.js",
    "test:headed": "playwright test -c src/playwright.config.js --headed",
    "test:install": "playwright install chromium",
    "check:invariants": "node src/scripts/check-invariants.js",
    "check:dupkeys": "node src/scripts/check-dupkeys.js --selftest && node src/scripts/check-dupkeys.js",
    "check:parity": "node src/scripts/check-mover-parity.js",
    "check:behaviour": "node src/scripts/check-mover-behaviour.js",
    "check:terrain": "node src/scripts/check-terrain-parity.js",
    "check:roads": "node src/scripts/check-roads.js",
    "check:roomsparity": "node src/scripts/check-rooms-parity.js",
    "check:duelparity": "node src/scripts/check-duel-parity.js",
    "check:questparity": "node src/scripts/check-quest-parity.js",
    "check:gateast": "node src/scripts/check-gate-parity.js",
    "check:rng": "node src/scripts/check-rng-parity.js",
    "check:questgraph": "node src/scripts/check-questgraph.js --selftest && node src/scripts/check-questgraph.js",
    "check:nodeindex": "node src/scripts/node-index.js --check",
    "check:noderegs": "node src/scripts/check-noderegs.js --selftest && node src/scripts/check-noderegs.js",
    "check:npcregs": "node src/scripts/check-npcregs.js --selftest && node src/scripts/check-npcregs.js",
    "check:anchors": "node src/scripts/resolve-anchors.js --selftest && node src/scripts/resolve-anchors.js",
    "check:legacycodes": "node src/scripts/legacy-codes.js --check",
    "legacy": "node src/scripts/legacy-codes.js",
    "check:arraypatch": "node src/scripts/check-array-patch.js",
    "check:itemchain": "node src/scripts/check-itemchain.js",
    "check:laddermigration": "node src/scripts/check-ladder-migration.js",
    "check:worlddiff": "node src/scripts/world-diff.js --selftest",
    "test:mud": "node src/tests/mud-harness.mjs",
    "check:walk": "npm run check:invariants && npm run check:dupkeys && npm run check:parity && npm run check:behaviour && npm run check:terrain && npm run check:roads && npm run check:roomsparity && npm run check:questparity && npm run check:gateast && npm run check:rng && npm run check:questgraph && npm run check:nodeindex && npm run check:noderegs && npm run check:npcregs && npm run check:anchors && npm run check:legacycodes"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
